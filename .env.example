# Weekly SOC Threat Intelligence Digest App Configuration

# Environment configuration: dev, test, or prod
APP_ENV=dev
APP_SECRET=some_secret_key_here

# Database DSN
# For SQLite local development (default):
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# For Docker MySQL connection (uncomment when running in container):
# DATABASE_URL="mysql://root:root@db:3306/soc_threat_digest?serverVersion=8.0.32&charset=utf8mb4"

# Symfony Messenger Async Queue DSN
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Threat Intelligence API Keys
# Optional: NVD API Key (increases rate limit)
NVD_API_KEY=your_nvd_api_key_here

# Required for OTX fetcher: AlienVault OTX API key
OTX_API_KEY=your_otx_api_key_here

# Optional: MalwareBazaar API key (Auth-Key)
MALWARE_BAZAAR_API_KEY=your_malware_bazaar_key_here

# Scheduler Timezone (default is Africa/Tunis)
APP_TIMEZONE=Africa/Tunis


